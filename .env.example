# Copy to .env for local use. Never commit .env.
# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, or local)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# Set to "false" only for a local/non-TLS database
DATABASE_SSL=true
# Comma-separated origins allowed for cross-origin calls (leave empty when UI and API share one Vercel domain)
ALLOWED_ORIGINS=
# Max accepted raw email size in bytes
MAX_EMAIL_BYTES=200000
# Local dev server port
PORT=3000
